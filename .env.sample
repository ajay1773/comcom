# =============================================================================
# ComCom - E-commerce Chatbot Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# LLM Configuration (Required)
# =============================================================================

# Groq API Key - Get from https://console.groq.com/keys
# This is REQUIRED for the chatbot to function
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
# Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Temperature (0.0 to 2.0)
# Lower = more focused/deterministic, Higher = more creative/random
# Default: 1.0
LLM_TEMPERATURE=1.0

# Ollama Model (for local LLM if desired)
# Default: llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# =============================================================================
# Security Configuration (Required)
# =============================================================================

# JWT Secret Key - Use a strong random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This is REQUIRED for user authentication
JWT_SECRET=your_jwt_secret_key_here

# =============================================================================
# Database Configuration (Optional)
# =============================================================================

# LangGraph Database (for conversation state/checkpointing)
# Default: langgraph.sqlite
DATABASE_URL=langgraph.sqlite

# Application Database (for users, products, orders, carts)
# Default: app_database.sqlite
APP_DATABASE_URL=app_database.sqlite

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# =============================================================================
# Streaming Configuration (Optional)
# =============================================================================

# JSON Buffer Size for streaming responses
# Default: 10000
STREAM_JSON_BUFFER_SIZE=10000

# =============================================================================
# Resilience & Circuit Breaker Configuration (Optional)
# =============================================================================

# Circuit Breaker: Number of failures before opening circuit
# Default: 5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Circuit Breaker: Recovery timeout in seconds
# Default: 60
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Retry: Maximum number of retry attempts
# Default: 3
RETRY_MAX_ATTEMPTS=3

# Retry: Base delay in seconds between retries
# Default: 1.0
RETRY_BASE_DELAY=1.0

# =============================================================================
# Search Configuration (Optional)
# =============================================================================

# Tavily Search: Maximum results to return
# Default: 2
TAVILY_MAX_RESULTS=2

# =============================================================================
# Custom System Prompt (Optional)
# =============================================================================

# Override the default system prompt for the AI assistant
# Leave blank to use the default ComAssist prompt
# SYSTEM_PROMPT=Your custom system prompt here
